{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "xy-forever-client": ["./node_modules/xy-forever-client/src/index.ts"],
      "xy-forever-client/dev": ["./node_modules/xy-forever-client/src/dev.ts"]
    }
  },
  "include": ["src", "scripts", "test", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
