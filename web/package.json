{
  "name": "xy-forever-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "XY Forever web app: a mod package manager and file manager for the OP-XY, over Web Serial (Chrome)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "xy-forever-client": "file:../clients/ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "^8.18.2",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "ws": "^8.22.0"
  }
}
