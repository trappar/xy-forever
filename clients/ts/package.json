{
  "name": "xy-forever-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client for the XY Forever serial protocol; src/v1.ts is generated by scripts/protogen.py",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./dev": "./src/dev.ts",
    "./test/*": "./test/*"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite demo",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node test/v1.test.ts && node test/modindex.test.ts && vitest run",
    "test:browser": "node test/browser.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "ws": "8.22.0"
  }
}
