{
  "name": "xy-forever-workspace",
  "private": true,
  "description": "pnpm workspace root: web/ and clients/ts share one lockfile (pnpm-lock.yaml)",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "firmware-build": "uv run --frozen scripts/firmware_cache.py run-build",
    "firmware-verify": "uv run --frozen scripts/firmware_cache.py run-verify"
  },
  "devDependencies": {
    "turbo": "2.11.13"
  }
}
