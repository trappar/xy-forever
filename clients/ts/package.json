{
  "name": "xy-forever-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript client for the XY Forever serial protocol; src/v1.ts is generated by scripts/protogen.py",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./dev": "./src/dev.ts",
    "./test/*": "./test/*"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "ws": "8.23.0"
  }
}
