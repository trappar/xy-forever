{
  "$schema": "./node_modules/turbo/schema.json",
  "cacheDir": ".turbo/cache",
  "remoteCache": {
    "enabled": false
  },
  "noUpdateNotifier": true,
  "cacheMaxSize": "1GB",
  "globalEnv": [
    "XYF_BUILD_KEY"
  ],
  "globalPassThroughEnv": [
    "XYF_PRIVATE",
    "XYF_TOOLCHAIN",
    "UV_*"
  ],
  "tasks": {
    "//#firmware-build": {
      "inputs": [
        "target/*.cpp",
        "target/*.hpp",
        "target/*.ipp",
        "target/*.inc",
        "target/*.s",
        "target/*.py",
        "native/*.cpp",
        "native/*.hpp",
        "native/*.ipp",
        "native/*.inc",
        "native/*.s",
        "native/*.py",
        "xy_forever/*.cpp",
        "xy_forever/*.hpp",
        "xy_forever/*.ipp",
        "xy_forever/*.inc",
        "xy_forever/*.s",
        "xy_forever/*.py",
        "toolchains.json",
        "stock_facts.json",
        "third_party/**",
        "scripts/firmware_cache.py"
      ],
      "outputs": [
        "build/product/**"
      ]
    },
    "//#firmware-verify": {
      "dependsOn": [
        "//#firmware-build"
      ],
      "inputs": [
        "scripts/firmware_cache.py"
      ],
      "outputs": []
    }
  }
}
